FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY config.py .
COPY services/__init__.py services/__init__.py
COPY services/ai_client.py services/ai_client.py
COPY services/catalog_service.py services/catalog_service.py

EXPOSE 8030

CMD ["python", "-m", "uvicorn", "services.catalog_service:app", "--host", "0.0.0.0", "--port", "8030"]
