FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY config.py .
COPY database.py .
COPY models.py .
COPY schemas.py .
COPY services/__init__.py services/__init__.py
COPY services/ai_client.py services/ai_client.py
COPY services/analysis_service.py services/analysis_service.py

EXPOSE 8010

CMD ["python", "-m", "uvicorn", "services.analysis_service:app", "--host", "0.0.0.0", "--port", "8010"]
